{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm db:deploy && pnpm build",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 6 * * *" },
    { "path": "/api/cron/publish", "schedule": "*/5 * * * *" }
  ]
}
