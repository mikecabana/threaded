# Copy to .env.local for local development. Everything is optional: with nothing
# set, the app runs the demo accounts. See docs/SETUP.md for where each value comes from.

# Threads (Meta developer app → Threads use case)
THREADS_APP_ID=
THREADS_APP_SECRET=
# Only for local sign-in (e.g. through a tunnel). On Vercel it's derived from the production URL.
THREADS_REDIRECT_URI=
# "1" asks for threads_keyword_search at sign-in, so Studio reads Threads posts on a topic.
# Add the permission to the Meta app first (docs/SETUP.md §1, step 7).
THREADS_KEYWORD_SEARCH=
# Overrides the production URL (Vercel provides VERCEL_PROJECT_PRODUCTION_URL).
APP_URL=
# Preview deployments that may use Threads sign-in, e.g. https://threaded-*-your-team.vercel.app
PREVIEW_ORIGINS=

# Encrypts Threads tokens and BYOK keys. Generate: openssl rand -base64 32
SECRETS_ENC_KEY=
SESSION_SECRET=

# Neon Postgres (injected by the Vercel Marketplace integration)
DATABASE_URL=

# Upstash Redis (injected by the Vercel Marketplace integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel AI Gateway. Local only; deployments authenticate via OIDC.
AI_GATEWAY_API_KEY=

# Stripe (test mode keys while developing). Payments are off until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 1 = add GST/HST and QST with Stripe Tax (head office and registrations set in Stripe first; docs/SETUP.md §3)
STRIPE_AUTOMATIC_TAX=

# Resend (alert emails). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
# Optional sender, on a domain verified in Resend (default: alerts@ the production domain)
EMAIL_FROM=

# Sentry error monitoring (docs/SETUP.md, "Monitoring and cookies"). Without a DSN nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
# Build only: uploads source maps so reports show real code
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Google Tag Manager container (GTM-…). Without it there are no optional cookies and no cookie banner.
GTM_ID=

# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=

# Threads user ids (Settings shows yours) that can open /admin, comma-separated
ADMIN_THREADS_USER_IDS=

# 1 = demo accounts only (preview deployments)
DEMO_MODE=
